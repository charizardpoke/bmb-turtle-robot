<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Robot body size -->
    <xacro:property name="base_length" value="0.261" />
    <xacro:property name="base_width" value="0.233" />
    <xacro:property name="base_height" value="0.120" />

    <!-- Wheel size and position -->
    <xacro:property name="wheel_radius" value="0.036" />
    <xacro:property name="wheel_length" value="0.040" />
    <xacro:property name="wheel_separation" value="0.235" />

    <!-- ROS front is +X. Put drive wheels near the front/motor side. -->
    <xacro:property name="wheel_from_front" value="0.050" />
    <xacro:property name="wheel_x_offset" value="${base_length / 2.0 - wheel_from_front}" />

    <link name="base_footprint" />

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
            <material name="blue" />
        </visual>

        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
        </collision>

        <xacro:box_inertia
            m="5.0"
            x="${base_length}"
            y="${base_width}"
            z="${base_height}"
            o_xyz="0 0 ${base_height / 2.0}"
            o_rpy="0 0 0" />
    </link>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
                <material name="grey" />
            </visual>

            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
            </collision>

            <xacro:cylinder_inertia
                m="1.0"
                r="${wheel_radius}"
                l="${wheel_length}"
                o_xyz="0 0 0"
                o_rpy="${pi / 2.0} 0 0" />
        </link>
    </xacro:macro>

    <xacro:wheel_link prefix="right" />
    <xacro:wheel_link prefix="left" />

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${wheel_radius / 2.0}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>

        <collision>
            <geometry>
                <sphere radius="${wheel_radius / 2.0}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>

        <xacro:sphere_inertia
            m="0.5"
            r="${wheel_radius / 2.0}"
            o_xyz="0 0 0"
            o_rpy="0 0 0" />
    </link>

    <!-- base_footprint is the floor frame. base_link sits wheel_radius above floor. -->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 ${pi}" />
    </joint>

    <!-- Right wheel: negative Y -->
    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel_link" />
        <origin xyz="${wheel_x_offset} ${-wheel_separation / 2.0} 0" rpy="0 0 ${pi}" />
        <axis xyz="0 1 0" />
    </joint>

    <!-- Left wheel: positive Y -->
    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel_link" />
        <origin xyz="${wheel_x_offset} ${wheel_separation / 2.0} 0" rpy="0 0 ${pi}" />
        <axis xyz="0 1 0" />
    </joint>

    <!-- Caster wheel goes at the back, negative X -->
    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_link" />
        <origin xyz="${-base_length / 3.0} 0 ${-wheel_radius / 2.0}" rpy="0 0 0" />
    </joint>

</robot>